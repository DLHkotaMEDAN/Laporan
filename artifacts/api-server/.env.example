# Database Configuration
# PostgreSQL connection string untuk database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/laporan

# Supabase Configuration (untuk auth verification)
# Copy dari Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# Server Configuration
NODE_ENV=development
PORT=19762
LOG_LEVEL=info

# Google Drive API Configuration (Server-side)
# Nilai ini bisa ditemukan di: Google Cloud Console → API & Services → Credentials
# Gunakan API key yang berbeda dengan client-side untuk security yang lebih baik
# Set proper restrictions: IP addresses, HTTP referrers, API restrictions

GOOGLE_CLIENT_ID=<your-server-side-google-client-id>
GOOGLE_API_KEY=<your-server-side-google-api-key>

# Security Note:
# - Jangan pernah commit file .env ke repository
# - Gunakan API key yang berbeda untuk development, staging, dan production
# - Set proper restrictions di Google Cloud Console untuk setiap environment
# - Monitor API usage secara regular untuk detect abuse
