# ============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================================
#
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository - sudah di-.gitignore
#
# Untuk setup instructions lengkap, lihat README.md
# ============================================================================

# ============================================================================
# SUPABASE CREDENTIALS
# ============================================================================
# Nilai ini bisa ditemukan di: Supabase Dashboard → Project Settings → API
#
# VITE_SUPABASE_URL: URL project Supabase Anda
# VITE_SUPABASE_ANON_KEY: Anon key untuk public access
#
# CATATAN: Anon key ini adalah public key yang boleh di-expose ke client
#         tapi tetap perlu dilindungi dari abuse dengan RLS policies

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ============================================================================
# GOOGLE DRIVE API CREDENTIALS (CLIENT-SIDE)
# ============================================================================
# Nilai ini bisa ditemukan di: Google Cloud Console → API & Services → Credentials
#
# SETUP INSTRUCTIONS:
# 1. Buat project di Google Cloud Console
# 2. Enable APIs: Google Drive API, Google Picker API
# 3. Create OAuth 2.0 Client ID (Web application)
#    - Authorized JavaScript origins: http://localhost:5173 (dev), https://yourdomain.com (prod)
# 4. Create API Key
#    - Application restrictions: HTTP referrers (localhost dan production domain)
#    - API restrictions: Google Drive API, Google Picker API
#
# SECURITY NOTES:
# - Client-side credentials akan terlihat di browser DevTools
# - Set proper restrictions di Google Cloud Console untuk mitigasi
# - Gunakan API key yang berbeda untuk development dan production
# - Monitor API usage secara regular untuk detect abuse
#
# FITUR: Jika credentials tidak diset, fitur Google Drive akan dinonaktifkan
#        dengan graceful fallback (tidak akan crash aplikasi)

VITE_GOOGLE_CLIENT_ID=<your-google-client-id>
VITE_GOOGLE_API_KEY=<your-google-api-key>

# ============================================================================
# OPTIONAL: PDF API URL
# ============================================================================
# URL untuk PDF generation API server
# Default: http://127.0.0.1:19762 (local development)
# Production: Set ke URL API server production Anda

VITE_PDF_API_URL=http://127.0.0.1:19762

# ============================================================================
# OPTIONAL: BASE PATH
# ============================================================================
# Base path untuk deployment (jika aplikasi di-deploy di subdirectory)
# Default: / (root)
# Example: /laporan untuk https://domain.com/laporan/

VITE_BASE_PATH=/

# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
# Sebelum commit atau deploy, pastikan:
# [ ] File ini disalin ke .env (bukan di-commit langsung)
# [ ] .env ada di .gitignore
# [ ] Credentials yang digunakan valid dan aktif
# [ ] API restrictions di Google Cloud Console sudah diset
# [ ] Database connection string sudah diset dengan benar
# [ ] Tidak ada hardcoded credentials di source code
# [ ] Environment-specific credentials sudah terpisah (dev/staging/prod)

