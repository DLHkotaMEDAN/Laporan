# Supabase project credentials
# Salin file ini menjadi .env lalu isi dengan nilai yang sesuai.
# Nilai ini bisa ditemukan di: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
# Email akun-akun privileged (pisahkan dengan koma jika lebih dari satu)
VITE_SUPER_ADMIN_EMAILS=admin@gmail.com
VITE_PIMPINAN_EMAILS=pimpinan@gmail.com
VITE_ADMIN_HARIAN_EMAILS=sakinah@gmail.com,admin.laporan@gmail.com
